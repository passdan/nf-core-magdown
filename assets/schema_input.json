{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/magdown/master/assets/schema_input.json",
    "title": "nf-core/magdown pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "MAGdir": {
                "type": "string",
                "format": "directory-path",
                "exists": true,
                "errorMessage": "MAG directory must be provided and must exist"
            }
        },
        "required": ["sample", "MAGdir"]
    }
}
